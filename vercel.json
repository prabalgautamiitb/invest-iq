{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "investiq-fe/", "framework": "vite", "buildCommand": "npm run build", "outputDirectory": "dist" },
    "api": { "root": "investiq-be/", "entrypoint": "app:app" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "daemons": {
    "worker": {
      "root": "investiq-be/", "entrypoint": "Dockerfile",
      "command": ["celery", "-q", "-A", "investiq.jobs.valuation:app", "worker", "--loglevel=WARNING", "--concurrency=2"],
      "instances": { "iad1": 1 },
      "resources": { "requests": { "memory": "1Gi" } },
      "terminationGracePeriodSeconds": 150
    },
    "scheduler": {
      "root": "investiq-be/", "entrypoint": "Dockerfile",
      "command": ["python", "-m", "investiq.jobs.scheduler"],
      "instances": { "iad1": 1 },
      "resources": { "requests": { "memory": "1Gi" } },
      "terminationGracePeriodSeconds": 30
    }
  }
}
