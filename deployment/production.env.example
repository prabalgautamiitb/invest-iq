# Put actual values in Vercel Production settings, not Git. Use a NEW hosted database.
VITE_API_BASE_URL=/api/v1
INVESTIQ_ENVIRONMENT=production
INVESTIQ_HOSTED_SIMULATION_ENABLED=true
INVESTIQ_DATABASE_URL=postgresql://USERNAME:PASSWORD@DATABASE_HOST/DATABASE?sslmode=verify-full
INVESTIQ_DATABASE_POOL_SIZE=1
INVESTIQ_DATABASE_MAX_OVERFLOW=0
INVESTIQ_DEPENDENCY_TIMEOUT_SECONDS=10
# Use standard Redis TCP/TLS URLs, not REST endpoints. Dedicated DBs or provider-supported DB indexes.
INVESTIQ_REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:6379/0
INVESTIQ_CELERY_BROKER_URL=rediss://default:PASSWORD@REDIS_HOST:6379/0?ssl_cert_reqs=required
INVESTIQ_VALUATION_QUEUE=investiq.production.valuation
INVESTIQ_RATE_LIMIT_PREFIX=investiq:production:identity
INVESTIQ_FRONTEND_URL=https://YOUR_APP_DOMAIN
INVESTIQ_CORS_ORIGINS=["https://YOUR_APP_DOMAIN","https://YOUR_ADMIN_DOMAIN"]
INVESTIQ_MARKET_DATA_MODE=yahoo
INVESTIQ_PUBLIC_CONTEST_FIXTURES_ENABLED=false
INVESTIQ_MARKET_SCAN_SECONDS=300
INVESTIQ_AI_PROVIDER=gemini
INVESTIQ_GEMINI_MODEL=REPLACE_WITH_SUPPORTED_MODEL
INVESTIQ_GEMINI_API_KEY=REPLACE_WITH_SECRET
INVESTIQ_AI_TIMEOUT_SECONDS=45
INVESTIQ_SMTP_HOST=SMTP_HOST
INVESTIQ_SMTP_PORT=587
INVESTIQ_SMTP_STARTTLS=true
INVESTIQ_SMTP_USERNAME=SMTP_USERNAME
INVESTIQ_SMTP_PASSWORD=REPLACE_WITH_SECRET
INVESTIQ_MAIL_FROM=InvestIQ <verified-sender@YOUR_DOMAIN>
