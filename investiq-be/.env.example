# Local development only; never use these credentials in production.
INVESTIQ_ENVIRONMENT=development
INVESTIQ_DATABASE_URL=postgresql+asyncpg://investiq:investiq_local@127.0.0.1:5433/investiq
INVESTIQ_REDIS_URL=redis://127.0.0.1:6380/0
INVESTIQ_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
INVESTIQ_LOG_LEVEL=INFO
INVESTIQ_DEPENDENCY_TIMEOUT_SECONDS=3
INVESTIQ_MARKET_DATA_MODE=fixture

# Local verification/recovery messages are captured at http://localhost:8025.
INVESTIQ_FRONTEND_URL=http://localhost:5173
INVESTIQ_SMTP_HOST=127.0.0.1
INVESTIQ_SMTP_PORT=1025
INVESTIQ_SMTP_STARTTLS=false
INVESTIQ_SMTP_USERNAME=
INVESTIQ_SMTP_PASSWORD=
INVESTIQ_MAIL_FROM=InvestIQ <no-reply@investiq.local>
INVESTIQ_SESSION_DAYS=7
INVESTIQ_AUTH_RATE_LIMIT=10
INVESTIQ_AUTH_RATE_WINDOW_SECONDS=900

# Simulation valuation jobs: separate broker DB, PostgreSQL remains authoritative.
INVESTIQ_CELERY_BROKER_URL=redis://127.0.0.1:6380/1
INVESTIQ_VALUATION_QUEUE=investiq.valuation
INVESTIQ_VALUATION_SCAN_SECONDS=60

# Release checked-in synthetic scenario prices at EOD (development only).
INVESTIQ_PUBLIC_CONTEST_FIXTURES_ENABLED=true
